```groovy
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('demo/demo') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('demo/demo') {
                    sh './mvnw test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('demo/demo') {
                    sh './mvnw package -DskipTests'
                }
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed. Check the console output.'
        }
    }
}
```


pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvnw.cmd test'
            }
        }

        stage('Package') {
            steps {
                bat 'mvnw.cmd package'
            }
        }
    }

    post {
        success {
            echo 'Mandaali Consultancies build completed successfully!'
        }
        failure {
            echo 'Build failed. Check the console output.'
        }
    }
}
    
